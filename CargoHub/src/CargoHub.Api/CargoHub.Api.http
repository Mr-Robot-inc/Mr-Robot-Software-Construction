
@baseUrl = http://localhost:8080

### =====================================
### SHIPMENTS
### =====================================

### Get all shipments
GET {{baseUrl}}/api/shipments

### Get shipment by ID
GET {{baseUrl}}/api/shipments/1


### Create shipment
POST {{baseUrl}}/api/shipments
Content-Type: application/json

{
  "reference": "SHIP-001",
  "orderId": 1,
  "shipmentDate": "2026-11-19T10:00:00Z",
  "shipmentType": "Outbound",
  "shipmentStatus": "Pending",
  "carrierName": "DHL",
  "shippingMethod": "Air",
  "paymentType": "Prepaid"
}


### =====================================
### ITEMS
### =====================================

### Get all items
GET {{baseUrl}}/api/items

### Get item by ID
GET {{baseUrl}}/api/items/1

### Create item
POST {{baseUrl}}/api/items
Content-Type: application/json

{
  "code": "ITEM-001",
  "description": "Wireless Keyboard",
  "barCode": "8712345678901",
  "modeNumber": "KB-100",
  "commodityCode": 1234,
  "unitWeight": 0.5,
  "itemLineId": 1,
  "itemGroupId": 1,
  "itemTypeId": 1,
  "minPurchaseQty": 1,
  "caseSize": 10,
  "packagingType": "Box",
  "orderMultiple": 1,
  "supplierId": 1,
  "supplierSku": "SUP-KB-001"
}


### =====================================
### SHIPMENT ITEMS
### =====================================

### Get all shipment items
GET {{baseUrl}}/api/shipmentitems

### Get shipment item by ID
GET {{baseUrl}}/api/shipmentitems/1

### Create shipment item
POST {{baseUrl}}/api/shipmentitems
Content-Type: application/json

{
  "shipmentId": 1,
  "itemId": 4,
  "amount": 25
}

### Update shipment item
PUT {{baseUrl}}/api/shipmentitems/1
Content-Type: application/json

{
  "shipmentId": 1,
  "itemId": 1,
  "amount": 50
}

### Delete shipment item
DELETE {{baseUrl}}/api/shipmentitems/1
